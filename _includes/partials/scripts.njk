<script>
var categories = [{% for cat in collections.categories %}"{{ cat.fileSlug }}"{% if not loop.last %},{% endif %}{% endfor %}];
function esc(t) { var d = document.createElement('div'); d.textContent = t == null ? '' : t; return d.innerHTML; }
function goRandom() {
  var groups = window._searchGroups;
  if (!groups || !groups.length) {
    // Only the homepage inlines the group list; other pages load it once, on first use.
    fetch('/search-data.json')
      .then(function(r) { if (!r.ok) throw new Error(r.status); return r.json(); })
      .then(function(data) { window._searchGroups = data; goRandom(); })
      .catch(function() {
        var cat = categories[Math.floor(Math.random() * categories.length)];
        window.location.href = "/" + cat + "/";
      });
    return;
  }
  var g = groups[Math.floor(Math.random() * groups.length)];
  var existing = document.getElementById('surprise-modal');
  if (existing) existing.remove();
  if (window._surpriseKey) document.removeEventListener('keydown', window._surpriseKey);
  var modal = document.createElement('div');
  modal.id = 'surprise-modal';
  modal.className = 'surprise-modal';
  modal.setAttribute('role', 'dialog');
  modal.setAttribute('aria-modal', 'true');
  modal.setAttribute('aria-label', 'A random group');
  modal.innerHTML =
    '<div class="surprise-modal-inner">' +
      '<button class="surprise-close" onclick="this.closest(\'.surprise-modal\').remove()" aria-label="Close">&times;</button>' +
      '<p class="surprise-label">You should check out</p>' +
      '<p class="surprise-name">' + esc(g.n) + '</p>' +
      '<p class="surprise-desc">' + esc(g.d) + '</p>' +
      '<p class="surprise-cat">' + esc(g.c) + '</p>' +
      '<div class="surprise-actions">' +
        '<a href="/' + g.s + '/#' + g.id + '" class="surprise-go">Take me there</a>' +
        '<button onclick="this.closest(\'.surprise-modal\').remove(); goRandom();" class="surprise-again">Try another</button>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
  requestAnimationFrame(function() { modal.classList.add('visible'); });
  var opener = document.activeElement;
  function close() {
    modal.remove();
    document.removeEventListener('keydown', onKey);
    if (opener && opener.focus) opener.focus();
  }
  function onKey(e) { if (e.key === 'Escape') close(); }
  window._surpriseKey = onKey;
  document.addEventListener('keydown', onKey);
  modal.addEventListener('click', function(e) { if (e.target === modal) close(); });
  modal.querySelector('.surprise-close').onclick = close;
  modal.querySelector('.surprise-go').focus();
  if (typeof umami !== 'undefined') umami.track('surprise', { group: g.n });
}
function sharePage(source, el) {
  var url = window.location.href;
  var title = document.title;
  function track() { if (typeof umami !== 'undefined') umami.track('share', { source: source }); }
  if (navigator.share) {
    navigator.share({ title: title, url: url }).then(track).catch(function() {});
  } else if (navigator.clipboard) {
    navigator.clipboard.writeText(url).then(function() {
      track();
      if (el) {
        var orig = el.textContent;
        el.textContent = 'Link copied!';
        setTimeout(function() { el.textContent = orig; }, 2000);
      }
    });
  }
}
if (!window._statsLoaded) {
  window._statsLoaded = true;
  fetch("https://vancouver-communities-stats.recipekit.workers.dev/")
    .then(function(r) { return r.json(); })
    .then(function(data) {
      window._statsData = data;
      var path = window.location.pathname;
      var pageViews = data.pages[path] || 0;
      var totalViews = data.total.pageviews || 0;
      var pageCounter = document.getElementById("page-views");
      if (pageCounter) pageCounter.textContent = pageViews.toLocaleString() + " views";
      var totalCounter = document.getElementById("total-views");
      if (totalCounter && totalViews) {
        // An old-web hit counter: one boxed digit per place, padded to seven.
        var digits = String(totalViews).padStart(7, "0").split("");
        totalCounter.setAttribute("aria-label", totalViews.toLocaleString() + " visits so far");
        totalCounter.innerHTML = '<span aria-hidden="true">You are visitor </span><span class="odometer" aria-hidden="true">' +
          digits.map(function(d) { return "<span>" + d + "</span>"; }).join("") + "</span>";
        totalCounter.hidden = false;
      }
    })
    .catch(function() {});
}
</script>
<script src="/_build/main.js"></script>
