<script>
var categories = [{% for cat in collections.categories %}"{{ cat.fileSlug }}"{% if not loop.last %},{% endif %}{% endfor %}];
function esc(t) { var d = document.createElement('div'); d.textContent = t == null ? '' : t; return d.innerHTML; }
// trigger: the button that was clicked (Safari doesn't focus buttons on click).
function goRandom(trigger) {
  // Ignore repeat clicks while the group list loads.
  if (window._surprisePending) return;
  // Remember who opened the first card, so "Try another" keeps the same
  // place to return focus to.
  var current = document.getElementById('surprise-modal');
  var active = trigger || document.activeElement;
  if (!current || !current.contains(active)) window._surpriseOpener = active;
  var groups = window._searchGroups;
  if (!groups || !groups.length) {
    // Only the homepage inlines the group list; other pages load it once, on first use
    // (shared with the masthead search).
    var busy = window._surpriseOpener;
    window._surprisePending = true;
    if (busy && busy.setAttribute) busy.setAttribute('aria-busy', 'true');
    var done = function() {
      window._surprisePending = false;
      if (busy && busy.removeAttribute) busy.removeAttribute('aria-busy');
    };
    (window.vcSearch ? window.vcSearch.load() : Promise.reject())
      .then(function() { done(); goRandom(busy); })
      .catch(function() {
        done();
        var cat = categories[Math.floor(Math.random() * categories.length)];
        window.location.href = "/" + cat + "/";
      });
    return;
  }
  var g = groups[Math.floor(Math.random() * groups.length)];
  if (current) { current.remove(); if (window.a11yDialog) a11yDialog.release(); }
  if (window._surpriseKey) document.removeEventListener('keydown', window._surpriseKey);
  var modal = document.createElement('div');
  modal.id = 'surprise-modal';
  modal.className = 'surprise-modal';
  modal.setAttribute('role', 'dialog');
  modal.setAttribute('aria-modal', 'true');
  modal.setAttribute('aria-labelledby', 'surprise-name');
  modal.setAttribute('aria-describedby', 'surprise-desc');
  modal.innerHTML =
    '<div class="surprise-modal-inner">' +
      '<button type="button" class="surprise-close" aria-label="Close">&times;</button>' +
      '<p class="surprise-label">You should check out</p>' +
      '<p class="surprise-name" id="surprise-name">' + esc(g.n) + '</p>' +
      '<p class="surprise-desc" id="surprise-desc">' + esc(g.d) + '</p>' +
      '<p class="surprise-cat">' + esc(g.c) + '</p>' +
      '<div class="surprise-actions">' +
        '<a href="/' + g.s + '/#' + g.id + '" class="surprise-go">Take me there</a>' +
        '<button type="button" class="surprise-again">Try another</button>' +
      '</div>' +
    '</div>';
  document.body.appendChild(modal);
  document.body.classList.add('modal-open');
  requestAnimationFrame(function() { modal.classList.add('visible'); });
  function close(restoreFocus) {
    document.removeEventListener('keydown', onKey);
    if (!modal.isConnected) return;
    modal.remove();
    document.body.classList.remove('modal-open');
    if (window.a11yDialog) a11yDialog.close(modal);
    var opener = window._surpriseOpener;
    window._surpriseOpener = null;
    if (restoreFocus !== false && opener && opener.isConnected && opener.focus) opener.focus();
  }
  function onKey(e) {
    // A page swap removes the modal without calling close(): just unhook.
    if (!modal.isConnected) { document.removeEventListener('keydown', onKey); return; }
    if (e.key === 'Escape') { e.preventDefault(); close(); }
  }
  window._surpriseKey = onKey;
  document.addEventListener('keydown', onKey);
  modal.addEventListener('click', function(e) { if (e.target === modal) close(); });
  modal.querySelector('.surprise-close').addEventListener('click', function() { close(); });
  modal.querySelector('.surprise-go').addEventListener('click', function() { close(false); });
  modal.querySelector('.surprise-again').addEventListener('click', function() { goRandom(); });
  if (window.a11yDialog) a11yDialog.open(modal);
  modal.querySelector('.surprise-go').focus();
  if (typeof umami !== 'undefined') umami.track('surprise', { group: g.n });
}
// Show a short message on a share button, then put its own label back.
function flashLabel(el, text) {
  if (!el) { if (window.announce) window.announce(text); return; }
  if (el.dataset.label == null) el.dataset.label = el.textContent;
  clearTimeout(el._flashTimer);
  el.textContent = text;
  if (window.announce) window.announce(text);
  el._flashTimer = setTimeout(function() { el.textContent = el.dataset.label; }, 2000);
}
function sharePage(source, el) {
  var url = window.location.href;
  var title = document.title;
  function track() { if (typeof umami !== 'undefined') umami.track('share', { source: source }); }
  if (navigator.share) {
    navigator.share({ title: title, url: url }).then(track).catch(function() {});
  } else if (navigator.clipboard) {
    navigator.clipboard.writeText(url).then(function() {
      track();
      flashLabel(el, 'Link copied');
    }).catch(function() {
      flashLabel(el, 'Copy the link from the address bar');
    });
  } else {
    flashLabel(el, 'Copy the link from the address bar');
  }
}
// Share one group card: its own #anchor URL, not the whole page.
// Returns false to stop the anchor jump; true (no share or clipboard) lets the link work as a permalink.
function shareGroup(el) {
  var card = el.closest('.group-card');
  if (!card || (!navigator.share && !navigator.clipboard)) return true;
  var url = window.location.origin + window.location.pathname + '#' + card.id;
  var label = el.querySelector('.group-card-share-label') || el;
  var name = el.getAttribute('data-umami-event-group') || document.title;
  if (navigator.share) {
    navigator.share({ title: name, url: url }).catch(function() {});
  } else {
    navigator.clipboard.writeText(url).then(function() {
      flashLabel(label, 'Link copied');
    }).catch(function() {
      // Put the group's link in the address bar instead.
      window.location.hash = card.id;
      flashLabel(label, 'Copy the link from the address bar');
    });
  }
  return false;
}
if (!window._statsLoaded) {
  window._statsLoaded = true;
  fetch("https://vancouver-communities-stats.recipekit.workers.dev/")
    .then(function(r) { return r.json(); })
    .then(function(data) {
      window._statsData = data;
      var path = window.location.pathname;
      var pageViews = data.pages[path] || 0;
      var totalViews = data.total.pageviews || 0;
      var pageCounter = document.getElementById("page-views");
      if (pageCounter) pageCounter.textContent = pageViews ? pageViews.toLocaleString() + " views" : "New list";
      var totalCounter = document.getElementById("total-views");
      if (totalCounter && totalViews) {
        // An old-web hit counter: one boxed digit per place, padded to seven.
        var digits = String(totalViews).padStart(7, "0").split("");
        totalCounter.innerHTML = '<span class="visually-hidden">' + totalViews.toLocaleString() + ' visits so far</span>' +
          '<span aria-hidden="true">You are visitor </span><span class="odometer" aria-hidden="true">' +
          digits.map(function(d) { return "<span>" + d + "</span>"; }).join("") + "</span>";
        totalCounter.hidden = false;
      }
    })
    .catch(function() {});
}
</script>
<script src="/_build/main.js"></script>
