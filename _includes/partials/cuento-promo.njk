{#- Cuento promo block. All copy and links come from _data/cuento.js.
    Set before including:
      promoVariant   "feature" (large card) or "compact" (one-line strip)
      promoPlacement utm_campaign / analytics label, e.g. "homepage"
      promoHeading   optional heading (feature only)
      promoBody      optional body text (feature only)
-#}
{%- set promoHref = cuento.link(promoPlacement) %}
{%- if promoVariant == "compact" %}
<aside class="cuento-promo cuento-promo-compact" aria-label="{{ cuento.name }}, reading circles">
  <p class="cuento-promo-text"><span class="cuento-promo-label">{{ cuento.label }}</span> {{ cuento.compactText }} {{ cuento.price }}</p>
  <a href="{{ promoHref }}" class="cuento-promo-link" target="_blank" rel="noopener" data-umami-event="click-cuento" data-umami-event-source="{{ promoPlacement }}">Visit {{ cuento.domain }} <span aria-hidden="true">&rarr;</span></a>
</aside>
{%- else %}
<aside class="cuento-promo cuento-promo-feature" aria-label="{{ cuento.name }}, reading circles">
  <div class="cuento-promo-main">
    <p class="cuento-promo-label">{{ cuento.label }}</p>
    <h2 class="cuento-promo-heading">{{ promoHeading or cuento.tagline }}</h2>
    <p class="cuento-promo-body">{{ promoBody or cuento.pitch }}</p>
    <p class="cuento-promo-price">{{ cuento.price }}</p>
  </div>
  <div class="cuento-promo-action">
    <a href="{{ promoHref }}" class="cuento-promo-btn" target="_blank" rel="noopener" data-umami-event="click-cuento" data-umami-event-source="{{ promoPlacement }}">{{ cuento.cta }} <span aria-hidden="true">&rarr;</span></a>
    <span class="cuento-promo-domain">{{ cuento.name }} &middot; {{ cuento.domain }}</span>
  </div>
</aside>
{%- endif %}
