{#- mutuals promo block. All copy and links come from _data/mutuals.js.
    Set before including:
      promoVariant   "feature" (large card) or "compact" (one-line strip)
      promoPlacement utm_campaign / analytics label, e.g. "homepage"
      promoHeading   optional heading (feature only)
      promoBody      optional one-sentence lead before the steps (feature only)
-#}
{%- set promoHref = mutuals.link(promoPlacement) %}
{%- if promoVariant == "compact" %}
<aside class="mutuals-promo mutuals-promo-compact" aria-label="{{ mutuals.name }}, neighbourhood book clubs">
  <p class="mutuals-promo-text"><span class="mutuals-promo-label">{{ mutuals.label }}</span> {{ mutuals.compactText }} {{ mutuals.price }}</p>
  <a href="{{ promoHref }}" class="mutuals-promo-link" target="_blank" rel="noopener" data-umami-event="click-mutuals" data-umami-event-source="{{ promoPlacement }}">Visit {{ mutuals.domain }} <span aria-hidden="true">&r{%- else %}
<aside class="mutuals-promo mutuals-promo-feature" aria-label="{{ mutuals.name }}, neighbourhood book clubs">
  <p class="mutuals-promo-label">{{ mutuals.label }}</p>
  <div class="mutuals-promo-main">
    <p class="mutuals-promo-brand"><svg class="mutuals-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="5" r="3.6"/><circle cx="19" cy="12" r="3.6"/><circle cx="12" cy="19" r="3.6"/><circle cx="5" cy="12" r="3.6"/></svg><span class="mutuals-promo-wordmark">{{ mutuals.name }}</span><span class="mutuals-promo-tld">.fm/vancouver</span></p>
    <h2 class="mutuals-promo-heading">{{ promoHeading or mutuals.headline }}</h2>
    {%- if promoBody %}
    <p class="mutuals-promo-body">{{ promoBody }}</p>
    {%- endif %}
    <ol class="mutuals-promo-steps">
      {%- for step in mutuals.steps %}
      <li>{{ step }}</li>
      {%- endfor %}
    </ol>
  </div>
  <div class="mutuals-promo-action">
    <a href="{{ promoHref }}" class="mutuals-promo-btn" target="_blank" rel="noopener" data-umami-event="click-mutuals" data-umami-event-source="{{ promoPlacement }}">{{ mutuals.cta }} <span aria-hidden="true">&rarr;</span></a>
    <p class="mutuals-promo-price">{{ mutuals.price }}</p>
  </div>
</aside>
{%- endif %}
