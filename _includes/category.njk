<!DOCTYPE html>
<html lang="en">
<head>
  {% include "partials/head.njk" %}
  {%- set titleHasGroupWord = "club" in title | lower or "group" in title | lower or "space" in title | lower or "bar" in title | lower -%}
  {%- if groupCount and titleHasGroupWord -%}
    {%- set metaTitle = groupCount + " " + title + " in Vancouver" -%}
  {%- elif groupCount -%}
    {%- set metaTitle = groupCount + " " + title + " Group" + ("s" if groupCount != 1) + " in Vancouver" -%}
  {%- else -%}
    {%- set metaTitle = title + " in Vancouver" -%}
  {%- endif -%}
  {#- Optional front matter overrides, written from Search Console queries:
      seoTitle / seoDescription ({n} = group count, {year} = build year), seoHeading (the h1). -#}
  {%- if seoTitle -%}
    {%- set pageTitle = seoTitle | replace("{n}", listingCount) | replace("{year}", buildYear) -%}
  {%- else -%}
    {%- set pageTitle = metaTitle + " (" + buildYear + ")" -%}
  {%- endif -%}
  {%- set liveDescription = description | liveCount(listingCount, groupCount) -%}
  {%- set pageDescription = (seoDescription | replace("{n}", listingCount)) if seoDescription else liveDescription -%}
  <title>{{ pageTitle }}{% if (pageTitle | length) <= 41 %} | {{ site.shortTitle }}{% endif %}</title>
  <meta name="description" content="{{ pageDescription }} Updated {% buildDateHuman %}.">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}/{{ page.fileSlug }}/">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ site.url }}/og-image.png">
  <link rel="canonical" href="{{ site.url }}/{{ page.fileSlug }}/">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "{{ title }} in Vancouver",
    "description": "{{ description }}",
    "url": "{{ site.url }}/{{ page.fileSlug }}/",
    {% if groupCount %}"numberOfItems": {{ groupCount }},{% endif %}
    "about": {
      "@type": "Thing",
      "name": "{{ title }}"
    },
    "isPartOf": {
      "@type": "WebSite",
      "name": "{{ site.title }}",
      "url": "{{ site.url }}"
    }{% if groupItems.length %},
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {{ groupItems.length }},
      "itemListElement": [
        {%- for item in groupItems %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "item": {
            "@type": "Organization",
            "name": "{{ item.name | replace('"', '\\"') }}"{% if item.description %},
            "description": "{{ item.description | replace('"', '\\"') }}"{% endif %}{% if item.url %},
            "url": "{{ item.url | safe }}"{% endif %}{% if item.location %},
            "location": {
              "@type": "Place",
              "address": {
                "@type": "PostalAddress",
                "addressLocality": "Vancouver",
                "addressRegion": "BC",
                "addressCountry": "CA"
              },
              "name": "{{ item.location | replace('"', '\\"') }}"
            }{% endif %}
          }
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }{% endif %}
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Vancouver Community Directory",
        "item": "{{ site.url }}/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ title }}",
        "item": "{{ site.url }}/{{ page.fileSlug }}/"
      }
    ]
  }
  </script>
</head>
<body class="category-page">
<a href="#main-content" class="skip-link">Skip to content</a>
{% include "partials/topbar.njk" %}

<main id="main-content">
  {%- set groupLabel = "" %}
  {%- set groupKey = "" %}
  {%- for g in groups %}
    {%- for cat in collections.categories %}
      {%- if cat.data.group == g.key and cat.fileSlug == page.fileSlug %}
        {%- set groupLabel = g.label %}
        {%- set groupKey = g.key %}
      {%- endif %}
    {%- endfor %}
  {%- endfor %}
  {%- set sponsor = null %}
  {%- for s in sponsors.listings %}
    {%- if s.category == page.fileSlug %}{% set sponsor = s %}{% endif %}
  {%- endfor %}

  {%- set mutualsCat = mutuals.categories[page.fileSlug] %}
  <div class="frame page">
    <p class="breadcrumbs">
      <a href="/">Directory</a> &rsaquo;
      {% if groupLabel %}<a href="/#group-{{ groupKey }}">{{ groupLabel }}</a> &rsaquo;{% endif %}
      <span class="breadcrumb-current">{{ title }}</span>
    </p>
    <div class="columns">
      <div class="col-main">
        <h1 class="page-title">{% if seoHeading %}{{ seoHeading }}{% else %}{{ title }}{% if not titleHasGroupWord %} Groups{% endif %} in Vancouver{% endif %}</h1>
        <p class="page-lede">{{ liveDescription }}</p>
        {%- set guideSlug = guides[page.fileSlug] %}
        {%- if guideSlug %}
        {%- for post in collections.posts %}{% if post.fileSlug == guideSlug %}
        <p class="page-guide">Our guide: <a href="{{ post.url }}" data-umami-event="click-guide" data-umami-event-category="{{ page.fileSlug }}">{{ post.data.title }}</a></p>
        {%- endif %}{% endfor %}
        {%- endif %}
        <ul class="page-actions">
          <li><button type="button" class="link-button" onclick="openEditModal('{{ page.fileSlug }}')" data-umami-event="click-suggest-edit" data-umami-event-category="{{ page.fileSlug }}">Suggest an edit</button></li>
        </ul>

        {#- Paid placement: top of the main column at every width (the advertise page promises "above the fold"). #}
        {%- if sponsor %}
        {%- set sponsorData = sponsor %}{% set sponsorSlot = page.fileSlug %}{% set sponsorDemo = false %}
        {% include "partials/sponsor-card.njk" %}
        {%- endif %}

        <section class="panel">
          <h2 class="panel-title">{{ listingCount }} {% if listNoun %}{{ listNoun }}{% else %}{{ title | lower }}{% if not titleHasGroupWord %} group{% if listingCount != 1 %}s{% endif %}{% endif %}{% endif %}</h2>
          <div class="panel-body category-entries">
            {{ content | stripH1 | cardify | safe }}
            <p class="panel-links">Know someone who'd like this list? <button type="button" class="link-button" onclick="sharePage('{{ page.fileSlug }}', this)" data-umami-event="click-share" data-umami-event-source="{{ page.fileSlug }}">Tell a friend</button></p>
          </div>
        </section>

        {#- Listings come first; the contextual mutuals card follows them. #}
        {%- if mutualsCat %}
        {%- set promoVariant = "feature" %}{% set promoPlacement = "category-" + page.fileSlug %}{% set promoHeading = mutualsCat.heading %}{% set promoBody = mutualsCat.lead %}
        {% include "partials/mutuals-promo.njk" %}
        {%- endif %}
      </div>

      <aside class="col-side">
        <section class="panel">
          <h2 class="panel-title">About this list</h2>
          <div class="panel-body">
            <table class="details">
              {#- Count, section and date already show in the lede, breadcrumb and masthead. #}
              <tr><th scope="row">Traffic</th><td><span id="page-views">&ndash;</span></td></tr>
            </table>
          </div>
        </section>

        {#- Category pages are where most visitors land; the signup lived in the
            category hero until July 2026, and signups stopped when it moved out. #}
        {% include "partials/newsletter.njk" %}

        {%- if not sponsor %}
        {%- set sponsorData = null %}{% set sponsorSlot = page.fileSlug %}{% set sponsorDemo = false %}
        {%- set sponsorPitch = "One sponsor per category, from $39/month." %}
        {% include "partials/sponsor-card.njk" %}
        {%- endif %}

        {%- if groupKey %}
        <section class="panel">
          <h2 class="panel-title">More in {{ groupLabel }}</h2>
          <div class="panel-body">
            <ul class="link-list link-list-tight">
              {%- for cat in collections.categories %}
              {%- if cat.data.group == groupKey and cat.fileSlug != page.fileSlug %}
              <li><a href="/{{ cat.fileSlug }}/" data-umami-event="click-related-category" data-umami-event-category="{{ cat.fileSlug }}">{{ cat.data.title }}</a>{% if cat.data.listingCount > 0 %}&nbsp;<span class="count">({{ cat.data.listingCount }})</span>{% endif %}</li>
              {%- endif %}
              {%- endfor %}
            </ul>
            <p class="panel-links">New in town? <a href="/start-here/">Start here</a> &middot; <a href="/blog/how-to-make-friends-in-vancouver/">How to make friends</a></p>
          </div>
        </section>
        {%- endif %}

        {%- if not mutualsCat %}
        {%- set promoVariant = "compact" %}{% set promoPlacement = "category-" + page.fileSlug %}
        {% include "partials/mutuals-promo.njk" %}
        {%- endif %}
      </aside>
    </div>
  </div>

  {% include "partials/footer.njk" %}
</main>

<!-- Suggest Edit Modal -->
<div id="edit-modal" class="edit-modal" role="dialog" aria-modal="true" aria-labelledby="edit-modal-title">
  <div class="edit-modal-inner">
    <button class="edit-modal-close" onclick="closeEditModal()" aria-label="Close">&times;</button>
    <h2 id="edit-modal-title" class="edit-modal-title">Suggest an edit</h2>
    <p class="edit-modal-desc">What needs to change? A closed group, wrong link, new info — anything helps.</p>
    <form id="edit-form" class="form">
      <p class="form-note">Fields marked * are required.</p>
      <div class="form-field">
        <label class="form-label" for="edit-summary">What should change? *</label>
        <textarea class="form-input" id="edit-summary" name="summary" required rows="4" placeholder="e.g. Social Run Club meets on Tuesdays now, not Wednesdays. New website: ..."></textarea>
      </div>
      <div class="form-field">
        <label class="form-label" for="edit-name">Your name (optional)</label>
        <input class="form-input" type="text" id="edit-name" name="name" placeholder="Patrick">
      </div>
      <input type="hidden" name="category" id="edit-category">
      <button class="form-submit" type="submit">Send suggestion</button>
      <span class="form-status" id="edit-status" role="status"></span>
    </form>
  </div>
</div>

<script>
var _editOpener = null;
var _editOpenedAt = 0;
function openEditModal(category) {
  var modal = document.getElementById('edit-modal');
  _editOpener = document.activeElement;
  _editOpenedAt = Date.now();
  document.getElementById('edit-category').value = category;
  modal.style.display = 'block';
  document.body.classList.add('modal-open');
  if (window.a11yDialog) a11yDialog.open(modal);
  var closeBtn = modal.querySelector('.edit-modal-close');
  if (closeBtn) closeBtn.focus();
}
function closeEditModal() {
  document.getElementById('edit-modal').style.display = 'none';
  document.body.classList.remove('modal-open');
  if (window.a11yDialog) a11yDialog.close(document.getElementById('edit-modal'));
  if (_editOpener) { _editOpener.focus(); _editOpener = null; }
}
document.getElementById('edit-modal').addEventListener('click', (e) => { if (e.target.id === 'edit-modal' && Date.now() - _editOpenedAt > 300) closeEditModal(); });
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && document.getElementById('edit-modal').style.display === 'block') closeEditModal();
});
document.getElementById('edit-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = e.target.querySelector('button[type="submit"]');
  const status = document.getElementById('edit-status');
  btn.disabled = true;
  btn.textContent = 'Sending...';
  const formData = new FormData(e.target);
  try {
    const res = await fetch('https://vancouver-community-submit.recipekit.workers.dev/edit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(Object.fromEntries(formData))
    });
    const result = await res.json();
    if (result.success) {
      if (typeof umami !== 'undefined') umami.track('submit-edit', { category: document.getElementById('edit-category').value });
      var formEl = document.getElementById('edit-form');
      formEl.innerHTML =
        '<p class="edit-success-message">Got it, thanks for helping keep this accurate.</p>' +
        '<p class="edit-success-actions"><a href="#" class="verify-funnel-link" onclick="sharePage(\'{{ page.fileSlug }}-edit\', this); return false;">Tell a friend about this list</a></p>';
      setTimeout(closeEditModal, 5000);
    } else throw new Error(result.error || 'Something went wrong');
  } catch (err) {
    status.className = 'form-status error';
    status.textContent = 'Could not send. Try again, or email vancouver@bolle.co.';
    btn.disabled = false;
    btn.textContent = 'Send suggestion';
  }
});
</script>

{% include "partials/scripts.njk" %}
</body>
</html>
