---
layout: false
permalink: /search-data.json
eleventyExcludeFromCollections: true
---
{%- set rows = [] -%}
{%- for cat in collections.categories -%}
  {%- for item in cat.data.groupItems -%}
    {%- set _ = rows.push({ n: item.name, d: item.description | truncate(120), c: cat.data.title, s: cat.fileSlug, id: item.name | mdAnchor, u: item.url, w: item.location, b: ("Free" if item.free else "") }) -%}
  {%- endfor -%}
{%- endfor -%}
{{ rows | dump | safe }}
