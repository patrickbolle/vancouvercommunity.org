          <li>One advertiser at a time</li>
        </ul>
        <a class="advertise-cta" href="https://tally.so/r/dbaRVr" target="_blank" rel="noopener" data-umami-event="click-advertise-form" data-umami-event-tier="sidebar-banner">Book the sidebar &rarr;</a>
      </div>
      <div class="advertise-tier">
        <h3>Newsletter feature</h3>
        <p class="advertise-tier-price">$25/issue</p>
