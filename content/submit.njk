---
layout: false
permalink: /submit/
---
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "partials/head.njk" %}
  <title>Submit a Group | {{ site.shortTitle }}</title>
  <meta name="description" content="Submit a community group, club, or meetup to be added to the Vancouver Community Directory.">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <link rel="canonical" href="{{ site.url }}/submit/">
</head>
<body class="category-page">
<a href="#main-content" class="skip-link">Skip to content</a>
{% include "partials/topbar.njk" %}
<main id="main-content">
  <div class="frame page">
  <h1 class="page-title">Submit a group</h1>
  <p class="page-lede">Know a community, club or meetup in Vancouver that should be listed here? This directory is community-built. Your suggestion helps everyone.</p>
  <div class="columns">
  <div class="col-main">
  <section class="panel">
  <h2 class="panel-title">Group details</h2>
  <div class="panel-body">

  <form id="submit-form" class="form submit-form">
    <p class="form-note">Fields marked * are required.</p>
    <div class="form-row">
      <div class="form-field">
        <label class="form-label" for="submit-name">Group name *</label>
        <input class="form-input" type="text" id="submit-name" name="name" required placeholder="e.g. Kits Social Run Club">
      </div>
      <div class="form-field">
        <label class="form-label" for="submit-category">Category *</label>
        <select class="form-input" id="submit-category" name="category" required>
          <option value="">Select a category...</option>
          {%- for cat in collections.categories %}
          <option value="{{ cat.data.title }}">{{ cat.data.title }}</option>
          {%- endfor %}
          <option value="Other">Other / not sure</option>
        </select>
      </div>
    </div>
    <div class="form-field">
      <label class="form-label" for="submit-description">What does this group do? *</label>
      <textarea class="form-input" id="submit-description" name="description" required rows="3" placeholder="e.g. Weekly social runs in Kitsilano. All paces welcome, free to join."></textarea>
    </div>
    <div class="form-field">
      <label class="form-label" for="submit-link">Website, Instagram, or Meetup link</label>
      <input class="form-input" type="url" id="submit-link" name="link" placeholder="https://instagram.com/yourgroup">
    </div>
    <div class="form-row">
      <div class="form-field">
        <label class="form-label" for="submit-cost">Cost</label>
        <select class="form-input" id="submit-cost" name="cost">
          <option value="">Not sure</option>
          <option value="Free">Free</option>
          <option value="By Donation">By donation</option>
          <option value="Paid">Paid</option>
        </select>
      </div>
      <div class="form-field">
        <label class="form-label" for="submit-availability">Who can join?</label>
        <select class="form-input" id="submit-availability" name="availability">
          <option value="">Not sure</option>
          <option value="Open to All">Open to all</option>
          <option value="Membership Required">Membership required</option>
        </select>
      </div>
    </div>
    <button class="form-submit" type="submit">Submit group</button>
    <p class="form-status" id="form-status" role="status"></p>
  </form>

  <script>
  document.getElementById('submit-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = document.getElementById('form-status');
    const btn = e.target.querySelector('button');
    const btnLabel = btn.textContent;
    if (btn.disabled) return;
    btn.disabled = true;
    status.className = 'form-status';
    status.textContent = '';
    btn.textContent = 'Submitting...';
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData);
    try {
      const res = await fetch('https://vancouver-community-submit.recipekit.workers.dev/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        status.className = 'form-status success';
        status.textContent = '✓ ' + result.message;
        if (typeof umami !== 'undefined') umami.track('submit-group', { category: data.category, name: data.name });
        e.target.reset();
      } else {
        throw new Error(result.error || 'Submission failed');
      }
    } catch (err) {
      status.className = 'form-status error';
      status.textContent = err instanceof TypeError
        ? 'Could not reach the server. Check your connection and try again, or email vancouver@bolle.co.'
        : err.message + ' Your answers are still here. Try again?';
    }
    btn.disabled = false;
    btn.textContent = btnLabel;
  });
  </script>
    </div>
  </section>
  </div>

  <aside class="col-side">
    <section class="panel">
      <h2 class="panel-title">What gets listed</h2>
      <div class="panel-body">
        <p>The test: <em>"If I'm into this, can I go here and find my people?"</em></p>
        <p><strong>Yes:</strong> clubs, meetups, studios with a community, venues that host niche community nights, classes where you meet like-minded people.</p>
        <p><strong>No:</strong> one-off events, shops, general city listings.</p>
        <p class="panel-note">I review every submission and add new groups weekly.</p>
      </div>
    </section>
  </aside>
  </div>
  </div>

  {% include "partials/footer.njk" %}
</main>
{% include "partials/scripts.njk" %}
</body>
</html>
