---
layout: false
permalink: /blog/
---
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "partials/head.njk" %}
  <title>Blog | {{ site.title }}</title>
  <meta name="description" content="Community updates, newsletter issues, and stories from Vancouver.">
  <meta property="og:title" content="Blog — Vancouver Community">
  <meta property="og:description" content="Community updates, newsletter issues, and stories from Vancouver.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}/blog/">
  <link rel="canonical" href="{{ site.url }}/blog/">
</head>
<body class="category-page">
<a href="#main-content" class="skip-link">Skip to content</a>
{% include "partials/topbar.njk" %}
<main id="main-content">
  <div class="frame page">
    <h1 class="page-title">Blog</h1>
    <p class="page-lede">Community updates, newsletter issues and stories from Vancouver.</p>
    <div class="columns">
      <div class="col-main">
        <section class="panel">
          <h2 class="panel-title">All posts</h2>
          {% set posts = collections.posts %}
          {% if posts.length > 0 %}
          <ul class="panel-body link-list">
            {%- for post in posts %}
            <li>
              <span class="link-list-note">{{ post.date | readableDate }}</span>
              <a href="{{ post.url }}">{{ post.data.title }}</a>
              {% if post.data.description %}<span class="link-list-note">{{ post.data.description }}</span>{% endif %}
            </li>
            {%- endfor %}
          </ul>
          {% else %}
          <div class="panel-body"><p>No posts yet. Check back soon.</p></div>
          {% endif %}
        </section>
      </div>
      <aside class="col-side">
{%- set sponsorData = sponsors.pages %}{% set sponsorSlot = "blog-index" %}{% set sponsorDemo = false %}{% set sponsorPitch = "Reach Vancouver people looking for their next group, class or hangout. Clearly labelled, one sponsor at a time." %}
        {% include "partials/sponsor-card.njk" %}

        {% include "partials/newsletter.njk" %}
      </aside>
    </div>
  </div>

  {% include "partials/footer.njk" %}
</main>
{% include "partials/scripts.njk" %}
</body>
</html>
