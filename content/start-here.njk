        {%- set promoVariant = "feature" %}{% set promoPlacement = "start-here" %}{% set promoHeading = "Make friends through books" %}{% set promoBody = "" %}
        {% include "partials/mutuals-promo.njk" %}

        {% include "partials/newsletter.njk" %}
      </aside>
    </div>
  </div>

  {% include "partials/footer.njk" %}
</main>
{% include "partials/scripts.njk" %}
</body>
</html>
