---
layout: false
permalink: /
---
{%- set totalGroups = 0 %}
{%- for cat in collections.categories %}
  {%- set totalGroups = totalGroups + cat.data.groupCount %}
{%- endfor %}
<!DOCTYPE html>
<html lang="en">
<head>
  {% include "partials/head.njk" %}
  <title>Vancouver Community Directory — {{ totalGroups }}+ Groups, Clubs & Meetups (2026)</title>
  <meta name="description" content="{{ site.description }}">
  <meta property="og:title" content="Vancouver Community Directory — Find Your People">
  <meta property="og:description" content="{{ site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}/">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Vancouver Community Directory — Find Your People">
  <meta name="twitter:description" content="{{ site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/og-image.png">
  <link rel="canonical" href="{{ site.url }}/">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "{{ site.title }}",
    "url": "{{ site.url }}",
    "description": "{{ site.description }}",
    "areaServed": {
      "@type": "City",
      "name": "Vancouver",
      "address": {
        "@type": "PostalAddress",
        "addressRegion": "BC",
        "addressCountry": "CA"
      }
    },
    "publisher": {
      "@type": "Person",
      "name": "Patrick Bollenbach",
      "url": "https://bollenbach.ca"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Community Categories in Vancouver",
    "numberOfItems": {{ collections.categories.length }},
    "itemListElement": [
      {%- for cat in collections.categories %}
      {
        "@type": "ListItem",
        "position": {{ loop.index }},
        "name": "{{ cat.data.title }}",
        "url": "{{ site.url }}/{{ cat.fileSlug }}/"{% if cat.data.groupCount %},
        "numberOfItems": {{ cat.data.groupCount }}{% endif %}
      }{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
  </script>
</head>
<body class="homepage">
<a href="#main-content" class="skip-link">Skip to content</a>
{% include "partials/topbar.njk" %}

<main id="main-content">
  <div class="frame page">
    <div class="columns">
      <div class="col-main">
        <h1 class="page-title">Find your people in Vancouver.</h1>
        <p class="page-lede">{{ totalGroups }}+ groups across {{ collections.categories.length }} categories. Run clubs, supper clubs, philosophy circles, maker spaces and more. Browse, click through, show up.</p>

        <form class="search" role="search" id="homepage-search-form">
          <label for="homepage-group-search" class="visually-hidden">Search the directory</label>
          <input type="search" id="homepage-group-search" class="search-input" placeholder="Search {{ totalGroups }}+ groups: hiking, chess, supper club…" autocomplete="off" data-umami-event="homepage-search">
          <button type="submit" class="search-btn">Search</button>
        </form>
        <p class="search-popular">Popular:
          <a href="/run-clubs/">run clubs</a> &middot;
          <a href="/book-clubs/">book clubs</a> &middot;
          <a href="/dinner-supper-clubs/">supper clubs</a> &middot;
          <a href="/hiking-outdoors/">hiking</a> &middot;
          <a href="/free/">free things</a>
        </p>
        <div id="search-results" class="search-results" style="display:none"></div>

        <div id="homepage-browse-content">
          <section class="panel" id="categories">
            <h2 class="panel-title">Browse {{ totalGroups }}+ groups</h2>
            <div class="panel-body directory">
              {%- for group in groups %}
              <div class="directory-group" id="group-{{ group.key }}">
                <h3 class="directory-heading"><img class="pixel-icon" src="/icons/{{ group.key }}.svg" width="16" height="16" alt="">{{ group.label | ampEscape | safe }}</h3>
                <ul class="directory-list">
                  {%- for cat in collections.categories %}
                  {%- if cat.data.group == group.key %}
                  <li><a href="/{{ cat.fileSlug }}/" data-umami-event="click-category" data-umami-event-category="{{ cat.fileSlug }}">{{ cat.data.title }}</a>{% if cat.data.listingCount > 0 %}&nbsp;<span class="count">({{ cat.data.listingCount }})</span>{% endif %}</li>
                  {%- endif %}
                  {%- endfor %}
                </ul>
              </div>
              {%- endfor %}
            </div>
          </section>

          <section class="panel">
            <h2 class="panel-title">A note from Patrick</h2>
            <div class="panel-body note">
              <img src="/patrick-face.jpg" alt="Patrick Bollenbach" class="note-photo" width="56" height="56" loading="lazy">
              <p>Vancouver can feel like a hard city to make friends. I built this directory to help.</p>
              <p>I add new groups every week. Know one I'm missing? <a href="/submit/" data-umami-event="click-submit-cta" data-umami-event-source="homepage-note">Tell me about it</a>.</p>
              <p class="panel-links"><a href="/about/">Why I made this &rarr;</a></p>
            </div>
          </section>

          {%- set sponsorData = sponsors.homepage %}{% set sponsorSlot = "homepage" %}{% set sponsorDemo = false %}
          {%- set sponsorPitch = "This is the front door of the directory. One partner at a time, clearly labelled, right where Vancouver looks for things to do." %}
          {% include "partials/sponsor-card.njk" %}
        </div>
      </div>

      <aside class="col-side">
        {%- if recentGroups.length > 0 %}
        <section class="panel">
          <h2 class="panel-title">Recently added</h2>
          <ul class="panel-body link-list">
            {%- for group in recentGroups %}
            <li>
              <a href="/{{ group.categorySlug }}/#{{ group.name | mdAnchor }}" data-umami-event="click-recent-group" data-group data-g-name="{{ group.name }}" data-g-desc="{{ group.description }}" data-g-cat="{{ group.categoryTitle }}" data-g-slug="{{ group.categorySlug }}"{% if group.url %} data-g-url="{{ group.url }}"{% endif %}{% if group.location %} data-g-where="{{ group.location }}"{% endif %}>{{ group.name }}</a>
              <span class="link-list-note">in {{ group.categoryTitle }}</span>
            </li>
            {%- endfor %}
          </ul>
        </section>
        {%- endif %}

        {%- set promoVariant = "feature" %}{% set promoPlacement = "homepage" %}{% set promoHeading = "" %}{% set promoBody = "" %}
        {% include "partials/mutuals-promo.njk" %}

        {% include "partials/newsletter.njk" %}

      </aside>
    </div>
  </div>

  {% include "partials/footer.njk" %}
</main>
<script>
var _searchGroups = [
{%- for cat in collections.categories -%}
  {%- for item in cat.data.groupItems -%}
  {n:"{{ item.name | replace('"', '\\"') | safe }}",d:"{{ item.description | replace('"', '\\"') | truncate(120) | safe }}",c:"{{ cat.data.title | safe }}",s:"{{ cat.fileSlug }}",id:"{{ item.name | mdAnchor }}",u:"{{ item.url | safe }}",w:"{{ item.location | replace('"', '\\"') | safe }}",b:"{% if item.free %}Free{% endif %}"},
  {%- endfor -%}
{%- endfor -%}
];
</script>
{% include "partials/scripts.njk" %}
</body>
</html>
